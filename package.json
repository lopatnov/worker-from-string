{
  "name": "@lopatnov/worker-from-string",
  "version": "2.1.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Oleksandr Lopatnov",
    "url": "https://github.com/lopatnov"
  },
  "description": "Create Web Workers from strings at runtime. A lightweight TypeScript library for dynamic worker generation in browsers.",
  "homepage": "https://lopatnov.github.io/worker-from-string/",
  "keywords": [
    "web-worker",
    "worker",
    "worker-threads",
    "blob",
    "dynamic-worker",
    "runtime",
    "browser",
    "typescript",
    "javascript",
    "parallel",
    "multithreading",
    "concurrency",
    "async"
  ],
  "main": "dist/worker-from-string.cjs",
  "module": "dist/worker-from-string.es.js",
  "browser": "dist/worker-from-string.js",
  "types": "dist/worker-from-string.d.ts",
  "exports": {
    ".": {
      "types": "./dist/worker-from-string.d.ts",
      "import": "./dist/worker-from-string.es.js",
      "require": "./dist/worker-from-string.cjs",
      "browser": "./dist/worker-from-string.js",
      "default": "./dist/worker-from-string.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopatnov/worker-from-string.git"
  },
  "bugs": {
    "url": "https://github.com/lopatnov/worker-from-string/issues"
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "npm run build && node run-tests.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@lopatnov/rollup-plugin-uglify": "^4.1.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.3.0",
    "express": "^5.2.1",
    "rollup": "^4.59.0",
    "terser": "^5.46.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
